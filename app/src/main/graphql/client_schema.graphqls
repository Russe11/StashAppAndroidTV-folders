extend schema @link(
    url: "https://specs.apollo.dev/nullability/v0.4",
    import: ["@semanticNonNull", "@semanticNonNullField", "@catch", "CatchTo", "@catchByDefault"]
)

extend schema @catchByDefault(to: NULL)

# --- NG real-time: entityChanged subscription (local schema extension) -------------------
#
# The pinned `stash-server` submodule tracks an older NG server whose schema predates the
# `entityChanged` subscription (server commit 0c4fc107). Repointing the submodule is Wave-2,
# Stream-H work (NG-awareness), out of scope for this live-refresh stream, so we extend the
# local schema here so Apollo codegen produces the `EntityChangedSubscription` operation. The
# shape is copied VERBATIM from the server contract
# (`Stash/graphql/schema/types/entity-change-event.graphql` + the Subscription field in
# `schema.graphql`) per the one-contract invariant — do not rename or "improve" it.
#
# When the submodule is later repointed to a server that already declares these, delete this
# block (and the matching `type Subscription`/`scalar Time` shims) to avoid a duplicate-type
# codegen error: the concatenated schema must declare each type exactly once.
#
# `Time` is already declared by the submodule (`types/scalars.graphql`), so we only `extend`
# the existing `Subscription` type rather than redeclaring it.
extend type Subscription {
    """
    NG-only. A real-time stream of metadata-only entity change events
    (create/update/destroy). Optionally filter by entity kind via `types`
    (e.g. ["Scene", "Tag"]); a nil/empty list streams all kinds. The payload carries no
    titles or paths — clients refetch the changed entity by id (or prune it on destroy).
    Gate consumption on serverCapabilities.features containing "entityChanged".
    """
    entityChanged(types: [String!]): EntityChangeEvent!
}

"""
NG-only. A metadata-only notification that a tracked top-level entity was created, updated, or
destroyed. kind + id + operation + time ONLY — deliberately NO titles, paths, or other content.
"""
type EntityChangeEvent {
    "The entity kind that changed, e.g. \"Scene\", \"Tag\", \"Performer\", \"Gallery\", \"Image\", \"Studio\", \"Group\", \"SceneMarker\", \"GalleryChapter\"."
    entity: String!
    "The affected entity's id."
    id: ID!
    "The operation that occurred: \"Create\", \"Update\", or \"Destroy\"."
    operation: String!
    "When the change occurred."
    time: Time!
}

# --- NG real-time: deviceBus presence + command channel (local schema extension) ----------
#
# Same situation as `entityChanged` above: the pinned `stash-server` submodule predates the NG
# `deviceBus` surface, so we vendor the types here so Apollo codegen produces the device-presence
# / command operations. The shape is copied VERBATIM from the server contract
# (`graphql/ng-snapshot/ng-schema.snapshot.graphql`, design §5) per the one-contract invariant —
# do NOT rename or "improve" any type/field/enum/argument. When the submodule is later repointed
# to a server that already declares these, delete this whole block (and the entityChanged block
# above) to avoid duplicate-type codegen errors.
#
# `Time`, `Query`, `Mutation` and `Subscription` are already declared by the submodule, so we only
# `extend` the existing roots and reference the existing `Time` scalar.

"Device class for presence/registry. Drives the online-devices list and command routing."
enum DeviceKind { TV  DESKTOP  MOBILE  OTHER }

"What a device can do. PLAY = can be a playback target; CONTROL = can drive other devices."
enum DeviceCapability { PLAY  CONTROL }

"The kind of presence change a DevicePresenceEvent reports."
enum PresenceChange { ONLINE  OFFLINE  PLAYBACK }

"Remote-control command verbs a controller can send to a target device."
enum DeviceCommandType { PLAY  PAUSE  RESUME  SEEK  STOP  ENQUEUE  NEXT  PREV }

"""
NG-only. A device registered on the ephemeral presence bus (in-memory on the server, never
persisted). Payloads carry IDs not titles — clients resolve scene names locally.
"""
type Device {
    "Stable client-generated UUID; the device's identity on the bus."
    id: ID!
    "User-facing device name (defaults to the host/device name, user-editable)."
    name: String!
    kind: DeviceKind!
    capabilities: [DeviceCapability!]!
    "True while lastSeen is within the presence TTL (~45s)."
    online: Boolean!
    lastSeen: Time!
    "The device's current live playback signal, if it has reported one."
    playback: PlaybackState
}

"A device's live playback signal (separate from server-side persisted resume). IDs not titles."
type PlaybackState {
    "The scene the device is playing, by id (null when stopped/idle)."
    sceneId: ID
    positionSeconds: Float!
    paused: Boolean!
    updatedAt: Time!
}

"A presence/playback change for one device on the bus."
type DevicePresenceEvent {
    device: Device!
    kind: PresenceChange!
}

"""
A command relayed from a controller to this target device. fromDeviceId is currently always the
empty string on the wire (DeviceCommandInput has no controller-id field yet) — do not rely on it
for TOFU until the server adds it.
"""
type DeviceCommandEvent {
    fromDeviceId: ID!
    type: DeviceCommandType!
    sceneId: ID
    sceneIds: [ID!]
    startSeconds: Float
    seekSeconds: Float
}

"Registration/heartbeat payload for a device joining the presence bus."
input DeviceInput {
    id: ID!
    name: String!
    kind: DeviceKind!
    capabilities: [DeviceCapability!]!
}

"A device's playback-state report (debounced ~2s by the reporting device)."
input PlaybackStateInput {
    deviceId: ID!
    sceneId: ID
    positionSeconds: Float!
    paused: Boolean!
}

"A command from a controller to a target device (relayed by the server to the target)."
input DeviceCommandInput {
    targetDeviceId: ID!
    type: DeviceCommandType!
    sceneId: ID
    sceneIds: [ID!]
    startSeconds: Float
    seekSeconds: Float
}

extend type Query {
    "NG-only. Online devices (lastSeen within TTL), for the online-devices list / send-to picker."
    devices: [Device!]!
}

extend type Mutation {
    "Connect + heartbeat (~every 20s); upserts, refreshes lastSeen, emits ONLINE on a fresh/recovered device."
    registerDevice(input: DeviceInput!): Device!
    "Graceful exit; emits OFFLINE; returns true if the device was present."
    unregisterDevice(deviceId: ID!): Boolean!
    "Report live playback (debounced ~2s); emits PLAYBACK; returns false if the device is not registered."
    updatePlaybackState(input: PlaybackStateInput!): Boolean!
    "Controller→target relay; returns true only if a live target subscriber received it."
    sendDeviceCommand(input: DeviceCommandInput!): Boolean!
}

extend type Subscription {
    "NG-only. All presence/playback changes (ONLINE/OFFLINE/PLAYBACK) for every device on the bus."
    devicePresence: DevicePresenceEvent!
    "NG-only. A target subscribes with its own deviceId; receives ONLY commands whose targetDeviceId == deviceId."
    deviceCommands(deviceId: ID!): DeviceCommandEvent!
}
